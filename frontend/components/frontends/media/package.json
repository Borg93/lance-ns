{
	"name": "@lance-media/media",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5173 --host 127.0.0.1",
		"build": "vite build",
		"preview": "vite preview --port 4173 --host 127.0.0.1",
		"start": "bun ./build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:tsgo": "tsgo --noEmit -p tsconfig.tsgo.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:live": "node e2e/annotator.e2e.mjs && node e2e/temporal.e2e.mjs && node e2e/read-plane.e2e.mjs",
		"prepare": "svelte-kit sync"
	},
	"dependencies": {
		"@xyflow/svelte": "^1.6.0",
		"@xyflow/system": "^0.0.77",
		"bits-ui": "^2.0.0",
		"clsx": "^2.1.1",
		"d3-force": "^3.0.0",
		"d3-hierarchy": "^3.1.2",
		"d3-scale": "^4.0.2",
		"d3-scale-chromatic": "^3.1.0",
		"elkjs": "^0.9.3",
		"embedding-atlas": "^0.21.0",
		"lucide-svelte": "^0.468.0",
		"svelte": "^5.36.0",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^2.5.5",
		"tailwind-variants": "^0.3.0",
		"valibot": "^1.4.2",
		"@lance/engine": "workspace:*",
		"@lance/labeling": "workspace:*",
		"@lance/ui": "workspace:*",
		"@lance/api": "workspace:*",
		"@rask/api": "workspace:*",
		"@rask/ui": "workspace:*"
	},
	"devDependencies": {
		"@lance/config": "workspace:*",
		"@playwright/test": "^1.61.1",
		"@sveltejs/kit": "^2.27.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/bun": "^1.2.0",
		"@types/d3-force": "^3.0.10",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-scale-chromatic": "^3.1.0",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@webgpu/types": "^0.1.70",
		"layerchart": "^2.0.0-next.64",
		"playwright-core": "^1.61.1",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.1.4",
		"tailwindcss": "^4.0.0",
		"tslib": "^2.8.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.7.2",
		"vite": "^7.0.0",
		"vitest": "^4.1.10"
	}
}
