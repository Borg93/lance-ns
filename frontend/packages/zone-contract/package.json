{
	"name": "@rask/zone-contract",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"check:tsgo": "tsgo --noEmit -p tsconfig.json",
		"test": "vitest run",
		"lint": "oxlint --config ../../.oxlintrc.json .",
		"fmt": "oxfmt --config ../../.oxfmtrc.json --ignore-path ../../.oxfmtignore . && prettier --write '**/*.{md,json}' --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern",
		"fmt:check": "oxfmt --config ../../.oxfmtrc.json --ignore-path ../../.oxfmtignore --check . && prettier --check '**/*.{md,json}' --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern"
	},
	"devDependencies": {
		"@lance/config": "workspace:*",
		"@types/node": "^26.1.1",
		"vitest": "^4.1.10"
	}
}
