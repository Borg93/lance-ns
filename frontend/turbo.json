{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": [
		"CI",
		"PLAYWRIGHT_BROWSERS_PATH",
		"PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD"
	],
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*"
			],
			"outputs": [
				"build/**",
				".svelte-kit/**",
				"dist/**"
			]
		},
		"check": {
			"dependsOn": [
				"^build"
			],
			"outputs": []
		},
		"check:tsgo": {
			"dependsOn": [
				"^build"
			],
			"outputs": []
		},
		"test": {
			"outputs": []
		},
		"test:e2e": {
			"dependsOn": [
				"build"
			],
			"cache": false,
			"outputs": []
		},
		"lint": {},
		"fmt": {
			"cache": false
		},
		"fmt:check": {},
		"dev": {
			"dependsOn": [
				"^build"
			],
			"cache": false,
			"persistent": true
		}
	}
}
