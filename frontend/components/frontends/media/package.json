{
	"name": "media",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --port 4173 --host 127.0.0.1",
		"start": "bun ./build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:tsgo": "tsgo --noEmit -p tsconfig.tsgo.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:live": "node e2e/annotator.e2e.mjs && node e2e/temporal.e2e.mjs && node e2e/read-plane.e2e.mjs",
		"lint": "oxlint --config ../../../.oxlintrc.json . && eslint '**/*.svelte' '**/*.svelte.ts' --no-error-on-unmatched-pattern",
		"fmt": "oxfmt --config ../../../.oxfmtrc.json --ignore-path ../../../.oxfmtignore . && prettier --write '**/*.svelte' '**/*.svelte.ts' '**/*.{css,md,json,html}' --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore --no-error-on-unmatched-pattern",
		"fmt:check": "oxfmt --config ../../../.oxfmtrc.json --ignore-path ../../../.oxfmtignore --check . && prettier --check '**/*.svelte' '**/*.svelte.ts' '**/*.{css,md,json,html}' --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore --no-error-on-unmatched-pattern"
	},
	"dependencies": {
		"@lance/engine": "workspace:*",
		"@lance/labeling": "workspace:*",
		"@lance/media-api": "workspace:*",
		"@lance/ui": "workspace:*",
		"@lucide/svelte": "^1.26.0",
		"@rask/api": "workspace:*",
		"@rask/ui": "workspace:*",
		"@xyflow/svelte": "^1.6.2",
		"@xyflow/system": "^0.0.79",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"d3-force": "^3.0.0",
		"d3-hierarchy": "^3.1.2",
		"d3-scale": "^4.0.2",
		"d3-scale-chromatic": "^3.1.0",
		"elkjs": "^0.12.0",
		"embedding-atlas": "^0.22.0",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.56.8",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@lance/config": "workspace:*",
		"@playwright/test": "^1.62.0",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/d3-force": "^3.0.10",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-scale-chromatic": "^3.1.0",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@webgpu/types": "^0.1.71",
		"apache-arrow": "^21.2.0",
		"layerchart": "^2.0.2",
		"playwright-core": "^1.62.0",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
}
