{
	"name": "lance-lineage-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test src/lib",
		"gen:openapi": "cd ../../.. && LINEAGE_DEMO_DATA_ENABLED=true PYTHONPATH=services uv run --no-sync python -c \"import json; from lineage.main import app; json.dump(app.openapi(), open('frontend/apps/web/openapi.json','w'), indent=2)\"",
		"gen:types": "openapi-typescript openapi.json -o src/lib/api.generated.ts",
		"prepare": "svelte-kit sync",
		"test:e2e": "playwright test",
		"gen:types:catalog": "openapi-typescript ../../../docs/catalog-openapi.json -o src/lib/catalog.generated.ts",
		"test:e2e:live": "playwright test -c playwright.live.config.ts"
	},
	"dependencies": {
		"@lance/ui": "workspace:*",
		"@lucide/svelte": "^1.21.0",
		"@xyflow/svelte": "^1.0.0",
		"apache-arrow": "^21.1.0",
		"bits-ui": "^1.0.0",
		"gsap": "^3.12.0"
	},
	"devDependencies": {
		"@lance/config": "workspace:*",
		"@playwright/test": "^1.61.1",
		"@sveltejs/kit": "^2.8.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^22.0.0",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.15.0",
		"svelte-adapter-bun": "^0.5.2",
		"svelte-check": "^4.7.3",
		"typescript": "^5.7.0",
		"vite": "^6.0.0"
	}
}
