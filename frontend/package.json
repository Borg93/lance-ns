{
	"name": "lance-frontend",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*",
		"components/frontends/*"
	],
	"scripts": {
		"build": "turbo run build",
		"check": "turbo run check",
		"check:tsgo": "turbo run check:tsgo",
		"dev": "turbo run dev",
		"test": "turbo run test && vitest run eslint-rules",
		"test:e2e": "turbo run test:e2e --filter=lance-lineage-web",
		"lint": "oxlint --deny-warnings .",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"lint:mfe": "prettier --check '{components/frontends/home,components/frontends/data,components/frontends/lineage,components/frontends/models,components/frontends/admin,packages/api,packages/rask-ui}/**/*.{ts,js,svelte,css,html,json,md}' --ignore-path .gitignore --ignore-path .prettierignore && eslint components/frontends/home components/frontends/data components/frontends/lineage components/frontends/models components/frontends/admin packages/api packages/rask-ui",
		"format:mfe": "prettier --write '{components/frontends/home,components/frontends/data,components/frontends/lineage,components/frontends/models,components/frontends/admin,packages/api,packages/rask-ui}/**/*.{ts,js,svelte,css,html,json,md}' --ignore-path .gitignore --ignore-path .prettierignore"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@typescript/native-preview": "^7.0.0-dev.20260622.1",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"oxfmt": "0.58.0",
		"oxlint": "1.73.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte-check": "^4.6.0",
		"turbo": "2.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"vitest": "^4.1.9"
	},
	"prettier": {
		"overrides": [
			{
				"files": "*.svelte",
				"options": {
					"parser": "svelte"
				}
			}
		],
		"plugins": [
			"prettier-plugin-svelte",
			"prettier-plugin-tailwindcss"
		],
		"printWidth": 100,
		"singleQuote": true,
		"trailingComma": "all",
		"useTabs": true
	},
	"packageManager": "bun@1.3.14",
	"patchedDependencies": {
		"svelte-adapter-bun@1.0.1": "patches/svelte-adapter-bun@1.0.1.patch"
	}
}
