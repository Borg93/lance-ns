{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**", ".svelte-kit/**"]
		},
		"check": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test": {
			"outputs": []
		},
		"test:e2e": {
			"dependsOn": ["build"],
			"cache": false,
			"outputs": []
		},
		"//#lint": {
			"cache": false
		},
		"//#fmt:check": {
			"cache": false
		}
	}
}
