{
	"name": "@rask/api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./client": {
			"types": "./src/client.ts",
			"default": "./src/client.ts"
		},
		"./lineage": {
			"types": "./src/lineage/index.ts",
			"default": "./src/lineage/index.ts"
		},
		"./generated/lineage": {
			"types": "./src/generated/lineage.ts",
			"default": "./src/generated/lineage.ts"
		},
		"./generated/catalog": {
			"types": "./src/generated/catalog.ts",
			"default": "./src/generated/catalog.ts"
		},
		"./oidc": {
			"types": "./src/oidc.ts",
			"default": "./src/oidc.ts"
		},
		"./bff": {
			"types": "./src/bff.ts",
			"default": "./src/bff.ts"
		}
	},
	"scripts": {
		"check": "tsgo --noEmit -p tsconfig.json",
		"check:tsgo": "tsgo --noEmit -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.70.1",
		"@types/node": "^26.1.1",
		"vitest": "^4.1.10"
	}
}
