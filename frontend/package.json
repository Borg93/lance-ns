{
	"name": "lance-frontend",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"check": "turbo run check",
		"test": "turbo run test",
		"test:e2e": "turbo run test:e2e --filter=lance-lineage-web",
		"lint": "oxlint --deny-warnings .",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check ."
	},
	"devDependencies": {
		"oxfmt": "0.58.0",
		"oxlint": "1.73.0",
		"turbo": "2.10"
	},
	"packageManager": "bun@1.3.14"
}
