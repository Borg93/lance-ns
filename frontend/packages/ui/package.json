{
	"name": "@lance/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"svelte": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./utils": {
			"types": "./src/utils.ts",
			"default": "./src/utils.ts"
		},
		"./sidebar": {
			"types": "./src/sidebar/index.ts",
			"svelte": "./src/sidebar/index.ts",
			"default": "./src/sidebar/index.ts"
		},
		"./*": {
			"svelte": "./src/*",
			"default": "./src/*"
		}
	},
	"scripts": {
		"check": "bunx svelte-check --tsconfig ./tsconfig.json"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"bits-ui": "^2.0.0",
		"lucide-svelte": "^0.468.0",
		"clsx": "^2.1.1",
		"tailwind-merge": "^2.5.5",
		"tailwind-variants": "^0.3.0"
	},
	"devDependencies": {
		"typescript": "^5.7.0",
		"svelte-check": "^4.0.0"
	}
}
