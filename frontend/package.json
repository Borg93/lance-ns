{
	"name": "lance-frontend",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"components/frontends/*"
	],
	"scripts": {
		"build": "turbo run build",
		"check": "turbo run check",
		"check:tsgo": "turbo run check:tsgo",
		"dev": "turbo run dev",
		"test": "turbo run test && vitest run eslint-rules",
		"test:e2e": "turbo run test:e2e",
		"gen:types": "bun run gen:types:lineage && bun run gen:types:catalog",
		"gen:types:lineage": "openapi-typescript ../docs/lineage-openapi.json -o packages/api/src/generated/lineage.ts",
		"gen:types:catalog": "openapi-typescript ../docs/catalog-openapi.json -o packages/api/src/generated/catalog.ts",
		"lint": "eslint components/frontends/home components/frontends/data components/frontends/lineage components/frontends/models components/frontends/admin components/frontends/media components/frontends/annotator packages/api packages/rask-ui packages/media-api packages/engine packages/labeling packages/ui",
		"fmt": "prettier --write '{components/frontends/home,components/frontends/data,components/frontends/lineage,components/frontends/models,components/frontends/admin,components/frontends/media,components/frontends/annotator,packages/api,packages/rask-ui,packages/media-api,packages/config,packages/engine,packages/labeling,packages/ui}/**/*.{ts,js,svelte,css,html,json,md}' --ignore-path .gitignore --ignore-path .prettierignore",
		"fmt:check": "prettier --check '{components/frontends/home,components/frontends/data,components/frontends/lineage,components/frontends/models,components/frontends/admin,components/frontends/media,components/frontends/annotator,packages/api,packages/rask-ui,packages/media-api,packages/config,packages/engine,packages/labeling,packages/ui}/**/*.{ts,js,svelte,css,html,json,md}' --ignore-path .gitignore --ignore-path .prettierignore"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte-check": "^4.7.3",
		"turbo": "2.10.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.10"
	},
	"prettier": {
		"overrides": [
			{
				"files": "*.svelte",
				"options": {
					"parser": "svelte"
				}
			}
		],
		"plugins": [
			"prettier-plugin-svelte",
			"prettier-plugin-tailwindcss"
		],
		"printWidth": 100,
		"singleQuote": true,
		"trailingComma": "all",
		"useTabs": true
	},
	"packageManager": "bun@1.3.14",
	"patchedDependencies": {
		"svelte-adapter-bun@1.0.1": "patches/svelte-adapter-bun@1.0.1.patch"
	}
}
