{
	"name": "@lance/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"svelte": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./utils": {
			"types": "./src/utils.ts",
			"default": "./src/utils.ts"
		},
		"./sidebar": {
			"types": "./src/sidebar/index.ts",
			"svelte": "./src/sidebar/index.ts",
			"default": "./src/sidebar/index.ts"
		},
		"./*": {
			"svelte": "./src/*",
			"default": "./src/*"
		}
	},
	"scripts": {
		"check": "bunx svelte-check --tsconfig ./tsconfig.json"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.26.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"svelte-check": "^4.7.3"
	}
}
