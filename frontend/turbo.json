{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": ["CI", "PLAYWRIGHT_BROWSERS_PATH", "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["build/**", ".svelte-kit/**", "dist/**"]
		},
		// `check` runs `svelte-kit sync`, which GENERATES and prunes `.svelte-kit/types` — the same tree
		// `vite build` is reading. With only `^build` these two ran CONCURRENTLY inside a package, and on
		// a cold checkout (CI, nothing cached) the build lost the race:
		//
		//     media:build: ENOENT … '/src/frontend/components/frontends/media/.svelte-kit/types/route_meta_data.json'
		//
		// It reads as a flake because it hits whichever zone happens to interleave, and it never
		// reproduces locally where `.svelte-kit` is already warm. Depending on the package's OWN build
		// serialises the two writers. `test` already did exactly this, for the same reason.
		"check": {
			"dependsOn": ["^build", "build"],
			"outputs": []
		},
		"check:tsgo": {
			"dependsOn": ["^build", "build"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": []
		},
		// The bundle-budget gate WEIGHS the zones' client output, so it is the one test task whose input
		// is another package's build. `test -> build` orders a package only against ITSELF, and no zone
		// depends on @repo/zone-contract (it is a gate, not a runtime dep), so this raced the zone builds
		// and measured a half-written output/client. manifest.test.ts fails if this list drifts.
		"@repo/zone-contract#test": {
			"dependsOn": ["home#build", "lakehouse#build", "media#build", "annotator#build"],
			"outputs": []
		},
		"test:e2e": {
			"dependsOn": ["build"],
			"cache": false,
			"outputs": []
		},
		"lint": {},
		"fmt": {
			"cache": false
		},
		"fmt:check": {},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"dev:proxy": {
			"cache": false,
			"persistent": true
		}
	}
}
